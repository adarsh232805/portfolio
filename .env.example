# Optional Backend Contact Endpoint (e.g. Serverless function / Formspree / Resend API webhook)
# If left empty, the contact form uses an automated mailto fallback
VITE_CONTACT_ENDPOINT=

# Optional AI Chat Backend Endpoint (e.g. OpenAI / Claude / Gemini API proxy backend)
# If left empty, the AI Assistant operates in 100% deterministic local FAQ knowledge base mode
VITE_AI_CHAT_ENDPOINT=
